{
  "manifest_version": 3,
  "name": "My Custom New Tab (React)",
  "version": "1.0",
  "description": "Shows bookmarks and tab groups in React",
  "permissions": ["bookmarks", "tabs", "tabGroups"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Custom Tab"
  }
}
